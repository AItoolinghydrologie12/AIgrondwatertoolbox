{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start app",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app/Home.py", "--server.address", "localhost"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        },
        {
            "name": "Debug huidige test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "justMyCode": false
        }
    ]
}
